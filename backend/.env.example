# Opcional: si lo dejás vacío, podés configurar el proveedor desde Presets → Proveedor.
OPENROUTER_API_KEY=

# Puerto local del backend y de la aplicación servida.
PORT=3001
# Dirección de escucha local. No la cambies a 0.0.0.0 sin una capa de seguridad.
HOST=127.0.0.1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Opcional: carpeta de datos (personajes, chats, presets, memoria, imágenes generadas).
# Vacío o ausente = backend/data. Si la completás, la data vive fuera del repositorio y
# ninguna operación de git puede tocarla. Útil para mantener datos personales a resguardo.
PLIEGO_DATA_DIR=
